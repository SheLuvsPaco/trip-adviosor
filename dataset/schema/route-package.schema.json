{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.trip-map/schema/route-package.schema.json",
  "title": "Interactive Trip Route Package",
  "type": "object",
  "required": [
    "schema_version",
    "route",
    "constraints",
    "scoring",
    "days",
    "place_ids",
    "budget",
    "validation"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "route": {
      "type": "object",
      "required": ["id", "slug", "name", "start_date", "end_date", "airport_date", "origin", "destination", "map_color"],
      "properties": {
        "id": { "type": "string", "pattern": "^route-[0-9]{2}$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 3 },
        "start_date": { "type": "string", "format": "date" },
        "end_date": { "type": "string", "format": "date" },
        "airport_date": { "type": "string", "format": "date" },
        "origin": { "$ref": "#/$defs/point" },
        "destination": { "$ref": "#/$defs/point" },
        "map_color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "status": { "enum": ["draft", "researched", "locked", "archived"] }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "object" },
    "scoring": { "type": "object" },
    "days": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/day" }
    },
    "place_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "budget": { "type": "object" },
    "validation": { "type": "object" }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["name", "coordinates"],
      "properties": {
        "name": { "type": "string" },
        "coordinates": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": -180, "maximum": 180 },
            { "type": "number", "minimum": -90, "maximum": 90 }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "leg": {
      "type": "object",
      "required": ["id", "from", "to", "distance_miles", "baseline_minutes", "planning_minutes", "traffic_risk"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "distance_miles": { "type": "number", "minimum": 0 },
        "distance_meters": { "type": "integer", "minimum": 0 },
        "baseline_minutes": { "type": "integer", "minimum": 0 },
        "planning_minutes": {
          "type": "object",
          "required": ["low", "high"],
          "properties": {
            "low": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 }
          }
        },
        "traffic_risk": { "enum": ["low", "medium", "high"] },
        "routing_source": { "type": "string" }
      }
    },
    "schedule_item": {
      "type": "object",
      "required": ["start", "end", "place_id", "priority"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "place_id": { "type": "string" },
        "priority": { "enum": ["anchor", "supporting", "optional", "logistics"] },
        "reservation": { "enum": ["required", "recommended", "none", "check-later"] }
      }
    },
    "day": {
      "type": "object",
      "required": ["day", "date", "sleep_city", "drive", "schedule", "weather"],
      "properties": {
        "day": { "type": "integer", "minimum": 1, "maximum": 11 },
        "date": { "type": "string", "format": "date" },
        "sleep_city": { "type": "string" },
        "drive": {
          "type": "object",
          "required": ["legs", "baseline_total_minutes", "planning_total_minutes", "cap_status"],
          "properties": {
            "legs": { "type": "array", "items": { "$ref": "#/$defs/leg" } },
            "baseline_total_minutes": { "type": "integer" },
            "planning_total_minutes": { "type": "object" },
            "cap_status": { "enum": ["comfortable", "near-cap", "live-traffic-gated"] },
            "fallback": { "type": ["string", "null"] }
          }
        },
        "schedule": { "type": "array", "items": { "$ref": "#/$defs/schedule_item" } },
        "weather": {
          "type": "object",
          "required": ["kind", "high_c", "low_c", "comfort_score", "source_id"],
          "properties": {
            "kind": { "const": "historical_normal" },
            "high_c": { "type": "number" },
            "low_c": { "type": "number" },
            "precipitation_probability_percent": { "type": ["number", "null"] },
            "comfort_score": { "type": "number", "minimum": 0, "maximum": 5 },
            "source_id": { "type": "string" }
          }
        }
      }
    }
  }
}
